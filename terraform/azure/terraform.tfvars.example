# 只有需要覆盖默认值时，才复制为不会提交到 Git 的 terraform.tfvars。
location        = "australiaeast"
name_prefix     = "finops"
environment     = "dev"
owner           = "your-name"
cost_center     = "learning"

# 可选功能：日志摄取可能持续产生费用，所以默认关闭。
enable_log_analytics         = false
log_analytics_retention_days = 30

additional_tags = {
  purpose = "portfolio-demo"
}
